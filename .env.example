# Copy to .env. Never commit .env.

# "local" on a developer's machine. Anything else (or unset) is treated as a deployment: the
# session cookie is sent over HTTPS only and /docs and /openapi.json are not served.
SQUAD_ENV=local
# To override either choice on its own:
# SESSION_COOKIE_SECURE=true
# API_DOCS_ENABLED=false

# The application's connection. In a deployment this is a login that is a member of
# `squad_runtime` (create it with: python -m app.cli runtime-login squad_app), which owns no
# table and may only SELECT and INSERT on the ledger. A local development database may use the
# owner for both, as below; `verify-ledger` warns when it does.
DATABASE_URL=postgresql+psycopg://squad:squad@localhost:5432/credit_agent_squad
# The owner's connection, used by migrations and by the owner-only commands in app.cli.
# Leave empty to use DATABASE_URL.
MIGRATION_DATABASE_URL=
# Password for the runtime login that `app.cli runtime-login` creates (docker compose needs it).
# At least 12 characters; letters and digits only, because it is placed in a connection URL.
RUNTIME_DATABASE_PASSWORD=
TEST_DATABASE_URL=postgresql+psycopg://squad:squad@localhost:5432/credit_agent_squad_test

SESSION_SECRET=change-me
FILE_STORE_DIR=./var/files
# Sign-in is refused for an account after this many failures inside the window.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Model access for the product's agents. Live runs are billable.
ANTHROPIC_API_KEY=
SQUAD_MODEL=claude-opus-5-5
SQUAD_LLM_MODE=recorded   # recorded | live | record
