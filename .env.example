# Copy to .env. Never commit .env.
DATABASE_URL=postgresql+psycopg://squad:squad@localhost:5432/credit_agent_squad
TEST_DATABASE_URL=postgresql+psycopg://squad:squad@localhost:5432/credit_agent_squad_test
SESSION_SECRET=change-me
FILE_STORE_DIR=./var/files
# Model access for the product's agents. Live runs are billable.
ANTHROPIC_API_KEY=
SQUAD_MODEL=claude-opus-5-5
SQUAD_LLM_MODE=recorded   # recorded | live | record
